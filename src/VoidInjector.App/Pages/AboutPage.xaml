<Page
    x:Class="VoidInjector.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="38,30,38,38">
        <StackPanel Spacing="22" MaxWidth="720" HorizontalAlignment="Left">
            <StackPanel Spacing="7">
                <TextBlock Text="THE PROJECT" Foreground="#9A83F7" FontSize="10"
                           FontWeight="SemiBold" CharacterSpacing="190" />
                <TextBlock Text="About VOID" Foreground="#F2F3FA"
                           FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="A focused desktop companion with a native Windows interface."
                           Foreground="#929BB0" FontSize="13" />
            </StackPanel>

            <Border Background="#141927" BorderBrush="#293248" BorderThickness="1"
                    CornerRadius="18" Padding="28">
                <StackPanel Spacing="17">
                    <Border Width="64" Height="64" CornerRadius="18" Background="#30264F"
                            BorderBrush="#59458B" BorderThickness="1"
                            HorizontalAlignment="Left">
                        <TextBlock Text="V" Foreground="#C7B9FF" FontSize="40"
                                   FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Spacing="5">
                        <TextBlock Text="VOID INTERNAL" Foreground="#F2F3FA"
                                   FontSize="22" FontWeight="Bold" CharacterSpacing="90" />
                        <TextBlock Text="Version 2.0  •  Fluent Edition"
                                   Foreground="#9A83F7" FontSize="12" />
                    </StackPanel>
                    <TextBlock Text="The desktop experience is built with C# and WinUI 3. The native game module remains a separate C++ component."
                               Foreground="#A2ABC0" FontSize="12" TextWrapping="Wrap" />
                    <Border Height="1" Background="#293248" />
                    <StackPanel Spacing="5">
                        <TextBlock Text="PROJECT REPOSITORY" Foreground="#7F8AA1"
                                   FontSize="9" CharacterSpacing="140" />
                        <HyperlinkButton Content="github.com/essde342-bit/Void-internal"
                                         NavigateUri="https://github.com/essde342-bit/Void-internal"
                                         Padding="0" HorizontalAlignment="Left" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <TextBlock Text="VOID  /  MADE FOR WINDOWS" Foreground="#657087"
                       FontSize="9" CharacterSpacing="150" />
        </StackPanel>
    </Grid>
</Page>

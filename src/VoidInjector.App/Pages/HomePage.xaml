<Page
    x:Class="VoidInjector.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="38,30,38,36" Spacing="24">
            <StackPanel Spacing="7">
                <TextBlock Text="LAUNCH CENTER" Foreground="#9A83F7" FontSize="10"
                           FontWeight="SemiBold" CharacterSpacing="190" />
                <TextBlock Text="Everything, under control." Foreground="#F2F3FA"
                           FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="A cleaner way to manage your local game client."
                           Foreground="#929BB0" FontSize="13" />
            </StackPanel>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.65*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#141927" BorderBrush="#293248"
                        BorderThickness="1" CornerRadius="18" Padding="26">
                    <StackPanel Spacing="17">
                        <Grid>
                            <StackPanel Spacing="5">
                                <TextBlock Text="TARGET APPLICATION" Foreground="#8C96AD"
                                           FontSize="10" FontWeight="SemiBold" CharacterSpacing="150" />
                                <TextBlock Text="Counter-Strike 2" Foreground="#F4F3FA"
                                           FontSize="22" FontWeight="SemiBold" />
                                <TextBlock Text="Steam  /  Windows x64" Foreground="#929BB0"
                                           FontSize="12" />
                            </StackPanel>
                            <Border Width="48" Height="48" CornerRadius="14"
                                    Background="#20283A" BorderBrush="#39445F" BorderThickness="1"
                                    HorizontalAlignment="Right" VerticalAlignment="Top">
                                <TextBlock Text="CS" Foreground="#E7E9F4" FontSize="18"
                                           FontWeight="Bold" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>

                        <Border Height="1" Background="#293248" />

                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="Auto,*">
                                <Ellipse x:Name="StatusIndicator" Width="8" Height="8"
                                         Fill="#9474FF" VerticalAlignment="Center" Margin="0,0,9,0" />
                                <TextBlock x:Name="StatusText" Grid.Column="1" Text="Ready when you are"
                                           Foreground="#F0F1F8" FontSize="13" FontWeight="SemiBold" />
                            </Grid>
                            <TextBlock x:Name="DetailText"
                                       Text="Press the button to begin. The launcher will check the local setup."
                                       Foreground="#929BB0" FontSize="12" TextWrapping="Wrap" />
                            <ProgressBar x:Name="OperationProgress" Minimum="0" Maximum="100"
                                         Value="0" Height="4" Background="#293248"
                                         Foreground="#9474FF" />
                        </StackPanel>

                        <Button x:Name="LaunchButton" Content="LAUNCH  /  INJECT"
                                Style="{StaticResource VoidAccentButtonStyle}"
                                HorizontalAlignment="Stretch" Click="OnInjectClicked" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <ProgressRing x:Name="BusyRing" Width="15" Height="15"
                                          IsActive="False" Visibility="Collapsed" />
                            <TextBlock Text="Keep VOID open during the operation."
                                       Foreground="#727D94" FontSize="10" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Spacing="14">
                    <Border Background="#111723" BorderBrush="#252E42" BorderThickness="1"
                            CornerRadius="16" Padding="20">
                        <StackPanel Spacing="9">
                            <TextBlock Text="CLIENT STATUS" Foreground="#8C96AD"
                                       FontSize="10" FontWeight="SemiBold" CharacterSpacing="145" />
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <Ellipse Width="8" Height="8" Fill="#55D6A1" VerticalAlignment="Center" />
                                <TextBlock Text="Local environment" Foreground="#E8EAF3"
                                           FontSize="13" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="The launcher runs locally on this PC."
                                       Foreground="#8993A8" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Background="#111723" BorderBrush="#252E42" BorderThickness="1"
                            CornerRadius="16" Padding="20">
                        <StackPanel Spacing="10">
                            <TextBlock Text="DIAGNOSTICS" Foreground="#8C96AD"
                                       FontSize="10" FontWeight="SemiBold" CharacterSpacing="145" />
                            <TextBlock Text="last_run.txt" Foreground="#F0F1F8"
                                       FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="The latest session log is available in the Logs tab."
                                       Foreground="#8993A8" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Background="#1A1730" BorderBrush="#44386D" BorderThickness="1"
                            CornerRadius="16" Padding="20">
                        <StackPanel Spacing="7">
                            <TextBlock Text="VOID DESIGN" Foreground="#B7A7FF"
                                       FontSize="10" FontWeight="SemiBold" CharacterSpacing="145" />
                            <TextBlock Text="Built to stay focused." Foreground="#F4F0FF"
                                       FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="A quiet interface, clear status and diagnostics close at hand."
                                       Foreground="#B3AACD" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#111520" BorderBrush="#252D40"
                        BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel Spacing="5">
                        <TextBlock Text="PLATFORM" Foreground="#7F8AA1" FontSize="9"
                                   CharacterSpacing="120" />
                        <TextBlock Text="Windows x64" Foreground="#E8EAF3" FontSize="13"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#111520" BorderBrush="#252D40"
                        BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel Spacing="5">
                        <TextBlock Text="UI FRAMEWORK" Foreground="#7F8AA1" FontSize="9"
                                   CharacterSpacing="120" />
                        <TextBlock Text="WinUI 3" Foreground="#E8EAF3" FontSize="13"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="#111520" BorderBrush="#252D40"
                        BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel Spacing="5">
                        <TextBlock Text="BUILD" Foreground="#7F8AA1" FontSize="9"
                                   CharacterSpacing="120" />
                        <TextBlock Text="2.0  /  FLUENT" Foreground="#E8EAF3" FontSize="13"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>

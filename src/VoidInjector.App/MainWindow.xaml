<Window
    x:Class="VoidInjector.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:VoidInjector.Pages"
    Title="VOID Injector">

    <Grid Background="{StaticResource VoidBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="#090B11">
            <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center" Margin="22,0,0,0">
                <Border Width="28" Height="28" CornerRadius="8" Background="#30264F"
                        BorderBrush="#59458B" BorderThickness="1">
                    <TextBlock Text="V" Foreground="#C2B2FF" FontSize="19" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Spacing="0" VerticalAlignment="Center">
                    <TextBlock Text="VOID" Foreground="#F4F2FF" FontSize="14"
                               FontWeight="Bold" CharacterSpacing="135" />
                    <TextBlock Text="INTERNAL  /  DESKTOP" Foreground="#8790A6"
                               FontSize="9" CharacterSpacing="95" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            OpenPaneLength="238"
            CompactPaneLength="68"
            SelectionChanged="OnNavigationSelectionChanged"
            Background="#0D1018"
            >

            <NavigationView.PaneHeader>
                <StackPanel Padding="22,18,12,18" Spacing="6">
                    <TextBlock Text="WORKSPACE" Foreground="#747E94" FontSize="10"
                               FontWeight="SemiBold" CharacterSpacing="160" />
                    <TextBlock Text="Control center" Foreground="#DDE0EB" FontSize="13"
                               FontWeight="SemiBold" />
                </StackPanel>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" Tag="home" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Logs" Tag="logs">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Settings" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="About" Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <StackPanel Padding="20,12,12,18" Spacing="7">
                    <Border Height="1" Background="#252D40" />
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="#55D6A1" />
                        <TextBlock Text="LOCAL CLIENT" Foreground="#8E98AD"
                                   FontSize="10" CharacterSpacing="90" />
                    </StackPanel>
                    <TextBlock Text="VOID  •  BUILD 2.0" Foreground="#626D83" FontSize="9" />
                </StackPanel>
            </NavigationView.PaneFooter>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
